{
  "name": "@gestao/shared-types",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist-esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist-esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "dist-esm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "dev": "tsc -b tsconfig.json tsconfig.esm.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist dist-esm"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gestao/tsconfig": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
