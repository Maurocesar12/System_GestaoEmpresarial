# Copie para `.env.local`. O `.env.local` NÃO vai para o repositório.
# Em produção, estas variáveis vivem no painel da Vercel.

# URL pública da API (NestJS). Sem barra no final.
NEXT_PUBLIC_API_URL=http://localhost:3333

# URL pública do site. Em produção, prefira o domínio definitivo.
# Na Vercel ela é inferida automaticamente se esta variável não existir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
