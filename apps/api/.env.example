# Copie para `.env` e preencha. O `.env` NÃO vai para o repositório.
# Em produção, estas variáveis vivem no painel do Render (arquitetura §9.3).

NODE_ENV=development
PORT=3333
API_PREFIX=api

# Origens liberadas no CORS, separadas por vírgula. Nunca use "*".
CORS_ORIGINS=http://localhost:3000

# Endereço público do frontend usado nos links de convite da equipe.
APP_URL=http://localhost:3000

# Conexão da APLICAÇÃO: usuário SEM BYPASSRLS (arquitetura §4.3).
# SSL obrigatório fora de desenvolvimento (§9.3).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/gestao?schema=public

# Conexão do PAINEL INTERNO: usuário COM BYPASSRLS, isolada da aplicação.
# Deixe vazia até o AdminModule entrar.
ADMIN_DATABASE_URL=

# Mínimo de 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-de-48-bytes

# Validade do access token (minutos) e do refresh token (dias).
JWT_ACCESS_TTL_MINUTOS=15
JWT_REFRESH_TTL_DIAS=7

# Plano Básico e trial de quem se cadastra.
ONBOARDING_PLANO_PADRAO=essencial
ONBOARDING_TRIAL_DIAS=14

# Redis do BullMQ (Upstash em produção). Liga o envio automático de lembretes:
# sem esta variável a API sobe normalmente, mas os lembretes ficam pendentes.
# Ex.: redis://localhost:6379
REDIS_URL=

# Rate limit global. Login e signup têm limite próprio, mais apertado.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Servidor SMTP do e-mail transacional (convites e lembretes de follow-up).
# Deixe vazio em desenvolvimento: sem SMTP_URL, a API apenas escreve a mensagem
# no log em vez de enviar de verdade.
# Resend: smtps://resend:re_SUA_CHAVE@smtp.resend.com:465
SMTP_URL=
# Em produção, troque pelo endereço do domínio verificado no provedor.
EMAIL_REMETENTE=Gestão Empresarial <nao-responda@localhost>

# IA financeira. Sem chave, o sistema continua funcionando em modo de
# demonstração, com análise determinística e custo zero.
# A chave fica apenas no Render; nunca use NEXT_PUBLIC_ nem coloque na Vercel.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
# Preço por 1 milhão de tokens, usado só para acompanhar custo por usuário.
OPENAI_CUSTO_INPUT_USD_MILHAO=0.20
OPENAI_CUSTO_OUTPUT_USD_MILHAO=1.20
